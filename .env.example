# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://visireport:visireport@postgres:5432/visireport
# SQLite fallback for local dev without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./visireport.db

# ─── Message broker ──────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=visireport.defects.exchange
RABBITMQ_QUEUE=visireport.defects.queue
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# ─── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── Cognitive layer (LLM) ───────────────────────────────────────────────
# Set LLM_PROVIDER to "anthropic" or "openai" and supply the matching key.
# Narrative/CAPA generation will return a 503 with a clear error until a
# valid key is supplied here - it will never fall back to fake text.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Vision / inference ──────────────────────────────────────────────────
MODEL_WEIGHTS_PATH=/app/weights/best.pt
DEFAULT_TILE_SIZE=640
DEFAULT_TILE_OVERLAP=64
DEFAULT_CONF_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45
MAX_UPLOAD_MB=25
MAX_IMAGE_DIM=4096

# ─── Misc ────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Seed credentials (created on first migration/seed run) ─────────────
SEED_ENGINEER_EMAIL=engineer@visireport.ai
SEED_ENGINEER_PASSWORD=change-me-please
